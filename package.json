{
  "name": "screensaver-enhancements",
  "version": "2.0.0",
  "description": "Disable screen hibernation",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:v2-probe": "rollup -c rollup.v2-probe.config.js",
    "watch": "rollup -c -w",
    "test": "tsc --noEmit && node --test tests/**/*.test.mjs && node tests/run-python-tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grails125/ScreenSaverEnhancements.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "grails",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Grails125/ScreenSaverEnhancements/issues"
  },
  "homepage": "https://github.com/Grails125/ScreenSaverEnhancements#readme",
  "devDependencies": {
    "@decky/ui": "4.11.6",
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.64.0",
    "rollup-plugin-external-globals": "0.11.0",
    "tslib": "^2.4.0",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "^4.4.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
